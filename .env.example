# Copy this file to .env for local Compose startup. Change every default before remote use.
APP_ENV=development
SECRET_KEY=local-development-only-change-before-deployment
POSTGRES_DB=lineguard
POSTGRES_USER=lineguard
POSTGRES_PASSWORD=local-only-change-me
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# JSON array, not comma separated. In production use the exact HTTPS frontend origin(s).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
COOKIE_SECURE=false
MAX_UPLOAD_MB=200
DEFAULT_FRAME_STRIDE=10
MAX_SAMPLED_FRAMES=1200
WORKER_POLL_SECONDS=1

# Live camera sampling; connect only authorized LAN cameras.
LIVE_CAMERA_SAMPLE_SECONDS=1.0
LIVE_EVENT_DEDUPE_SECONDS=60
# Optional user-supplied YOLO weights. In Compose, place files in /app/data/models (persistent data volume).
YOLO_MODEL_PATH=
YOLO_MODEL_ROOT=
# Set BACKEND_EXTRAS=yolo-cpu, plc, or industrial to install optional runtimes (large PyTorch image).
BACKEND_EXTRAS=
# PLC integration defaults to safe simulation; hardware outputs remain disabled.
PLC_MODE=simulation
PLC_HOST=
PLC_PORT=502
PLC_UNIT_ID=1
PLC_STOP_REQUEST_COIL=0
PLC_OUTPUTS_ENABLED=false
